# /etc/systemd/system/changingworld.service
[Unit]
Description=Changing World : API et admin éditoriale
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/changingworld
Environment=NODE_ENV=production
# Node 22 installé par nvm : remplacer NODE_BIN par la sortie de `dirname $(which node)` sous le compte ubuntu.
Environment=PATH=NODE_BIN:/usr/local/bin:/usr/bin:/bin
# Les secrets restent dans /var/www/changingworld/.env (lu par l'API au démarrage)
ExecStart=NODE_BIN/node /var/www/changingworld/node_modules/tsx/dist/cli.mjs /var/www/changingworld/apps/api/src/index.ts
Restart=always
RestartSec=5
StandardOutput=append:/var/log/changingworld/sortie.log
StandardError=append:/var/log/changingworld/erreurs.log

[Install]
WantedBy=multi-user.target
