# Mot de passe unique de l'admin (Bernard)
ADMIN_PASSWORD=changez-moi

# Secret servant à signer le cookie de session (32 caractères aléatoires ou plus)
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Clé OpenAI. Si elle est absente, l'app tourne en mode démo avec un faux client IA.
OPENAI_API_KEY=

# Modèle OpenAI par défaut (modifiable ensuite dans Réglages)
OPENAI_MODEL=gpt-4.1-mini

# Chemin du fichier SQLite (relatif à la racine du dépôt)
DATABASE_PATH=./data/changing-world.sqlite

# Port de l'API (l'admin Vite redirige /api vers ce port)
PORT=3001
